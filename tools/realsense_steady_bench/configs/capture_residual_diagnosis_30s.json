        "depth": "848x480_Z16_30fps",
        "color": "640x480_RGB8_30fps",
        "infrared": "disabled"
      },
      "physical": {
        "camera_count": 1,
        "camera_models": "D455",
        "hub_label": "powered_usb3_hub_with_other_cameras_idle",
        "root_hub_label": "record_from_topology_snapshot",
        "usb_speed_label": "usb3_superspeed"
      },
      "probe": {
        "camera_count": 1,
        "serials": ["311322304911"],
        "stream_mode": "depth_color",
        "delivery": "wait",
        "frames": 900,
        "measurement_duration_ms": 30000,
        "warmup_frames": 30,
        "warmup_health_window_frames": 10,
        "frame_timeout_ms": 1500,
        "startup_timeout_ms": 15000,
        "fps": 30,
        "depth_width": 848,
